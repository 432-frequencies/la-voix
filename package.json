{
  "name": "la-voix",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.server.json --noEmit",
    "preview": "vite preview",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck:legacy": "tsc -p jsconfig.json --noEmit",
    "content:import": "tsx scripts/import-content.ts",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/restore.ts",
    "format": "prettier --write \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" src/api/client.js src/lib/AuthContext.jsx src/pages/Account.jsx src/pages/DevMail.jsx src/App.jsx"
  },
