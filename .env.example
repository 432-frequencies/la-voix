# npm run dev creates a private .env with random local credentials if absent.
APP_URL=http://localhost:5173
DATABASE_URL=postgresql://lavoix:CHANGE_ME@127.0.0.1:55432/lavoix
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_MODE=true
# Docker Compose only:
POSTGRES_PASSWORD=CHANGE_ME
# Optional SMTP; otherwise local development mail is available at /dev-mail.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=LA VOIX <noreply@example.org>
# Optional Google sign-in; callback: APP_URL/api/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
